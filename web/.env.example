# Arc Guard web app. All values are public (inlined into the static build).
# ArcGuard contract on Arc mainnet. Unset = the app shows "Not deployed on Arc yet". A ?guard=0x… URL param overrides it.
NEXT_PUBLIC_ARC_GUARD_ADDRESS=
# Block the contract was deployed in; the passbook reads events from here. Unset = found by binary search (then cached).
NEXT_PUBLIC_ARC_GUARD_DEPLOY_BLOCK=
# The builder's box shown by "See a real box" (/box).
NEXT_PUBLIC_TOUR_OWNER=
# Optional: repo link in the footer.
NEXT_PUBLIC_SOURCE_URL=
# Optional, testing only: point reads at another RPC (e.g. a local anvil fork of Arc mainnet).
NEXT_PUBLIC_ARC_RPC_URL=
